# Copy this file to .env and fill in real values. Never commit .env!

# Optional: Hugging Face token for private model access (not required for FinBERT)
HF_TOKEN=

# Optional: NewsAPI key for live news feed (leave blank to use synthetic feed)
NEWS_API_KEY=

# App settings (can also be set in config.yaml)
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
